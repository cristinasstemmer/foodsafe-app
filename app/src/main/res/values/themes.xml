<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Base application theme. -->
    <style name="Theme.FoodSafe" parent="Theme.Material3.Light.NoActionBar">
        <!-- Customize your theme here. -->
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryVariant">@color/colorPrimaryDark</item>
        <item name="colorOnPrimary">@color/colorOnPrimary</item>

        <item name="colorSecondary">@color/colorSecondary</item>
        <item name="colorSecondaryVariant">@color/colorAccent</item>
        <item name="colorOnSecondary">@color/colorOnSecondary</item>

        <item name="android:statusBarColor">?attr/colorPrimaryDark</item>

    </style>

    <style name="Theme.FoodSafe.NoActionBar.Splash" parent="Theme.FoodSafe">
        <item name="windowNoTitle">true</item>
        <item name="windowActionBar">false</item>
        <item name="android:windowBackground">@color/colorOnPrimary</item>
        <item name="android:statusBarColor">@color/colorPrimaryDark</item>
    </style>

    <style name="Theme.FoodSafe.AppBarOverlay" parent="ThemeOverlay.AppCompat.Dark.ActionBar" />
    <style name="Theme.FoodSafe.PopupOverlay" parent="ThemeOverlay.AppCompat.Light" />

    <style name="ChipStyle" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:minHeight">32dp</item>
        <item name="android:textSize">14sp</item>
        <item name="strokeColor">@color/colorPrimary</item>
        <item name="android:textColor">@color/colorPrimary</item>
        <item name="cornerRadius">16dp</item>
    </style>

    <style name="ChipStyle.Selected" parent="ChipStyle">
        <item name="android:backgroundTint">@color/colorPrimary</item>
        <item name="android:textColor">@color/white</item>
        <item name="strokeWidth">0dp</item>
    </style>

    <style name="BottomSheetStyle" parent="Widget.Design.BottomSheet.Modal">
        <item name="android:background">@drawable/bottom_sheet_background</item>
    </style>

    <style name="BottomSheetDialogTheme" parent="Theme.MaterialComponents.Light.BottomSheetDialog">
        <item name="bottomSheetStyle">@style/BottomSheetStyle</item>
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorOnPrimary">@color/colorOnPrimary</item>
    </style>


    <style name="ChipStyle.Vegan" parent="ChipStyle">
        <item name="android:textColor">@color/colorPrimary</item>
        <item name="android:backgroundTint">@color/colorPrimaryDark</item>
    </style>
    <style name="ChipStyle.GlutenFree" parent="ChipStyle.Vegan" />
    <style name="ChipStyle.LactoseFree" parent="ChipStyle.Vegan" />

    <style name="ChipStyle.AllergyHigh" parent="ChipStyle">
        <item name="android:textColor">@color/red_accent</item>
        <item name="android:backgroundTint">@color/red_light</item>
    </style>
    <style name="ChipStyle.AllergyMedium" parent="ChipStyle.AllergyHigh" />

    <style name="ProfileStatsBox">
        <item name="android:padding">16dp</item>
        <item name="android:background">@drawable/rounded_card_background</item>
    </style>

    <style name="ShapeAppearanceOverlay.App.CornerSize50Percent" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>

</resources>
